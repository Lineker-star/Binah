# =============================================================================
# Binah — Low-bandwidth / cost-conscious deployment profile
# =============================================================================
# This is a TEMPLATE, not live config: copy the lines you want into your real
# .env.local (or use this file directly as .env.local — see docker-compose.yml
# for how env_file: .env.local is wired in). Nothing here is read by the app
# unless it ends up in .env.local.
#
# Intent: default a fresh Binah install to a free, local LLM (Ollama) and
# disable every capability that costs money or burns bandwidth per use
# (cloud image/video generation, premium TTS, paid web search), so an
# institution on limited/expensive connectivity (this profile was written for
# a deployment in Cameroon) gets a safe, predictable baseline. Every switch
# below can be flipped back on per-deployment once you know you want the cost.
#
# See .env.example for the full, authoritative list of every variable this
# app reads — this file only reproduces the ones this profile touches.


# --- Default model: local Ollama ---------------------------------------------
# Requires Ollama installed and running, with the model pulled first:
#   ollama pull llama3.3
#
# Setting OLLAMA_BASE_URL here (server-side) is what makes Ollama show up as a
# ready-to-use provider for every visitor automatically, with no per-user
# Settings step, and it bypasses the SSRF guard that would otherwise block a
# *client-supplied* localhost URL — you do NOT need ALLOW_LOCAL_NETWORKS=true
# for this. That flag is only for someone typing localhost into the Settings
# UI by hand.
OLLAMA_BASE_URL=http://localhost:11434/v1
# If the Binah app itself runs inside Docker while Ollama runs on the host
# machine, "localhost" won't resolve from inside the container. Use instead:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434/v1   (Docker Desktop, Mac/Windows)
# or run Ollama as its own service on the same compose network.

# Restricts/pins which locally-pulled models are offered. List only what
# you've actually pulled with `ollama pull`.
OLLAMA_MODELS=llama3.3

# Server-side fallback for stages that don't receive a client-selected model
# (see .env.example's "Server-backed Persistence"/"Misc" sections for which
# stages this covers). Without this, those specific stages fail outright on a
# machine with nothing else configured.
DEFAULT_MODEL=ollama:llama3.3

# To go back to a cloud LLM later for a given deployment: set that provider's
# own <PREFIX>_API_KEY / <PREFIX>_BASE_URL in .env.example's "LLM Providers"
# section and update DEFAULT_MODEL to e.g. openai:gpt-5.5 — Ollama stays
# available alongside it either way.


# --- Image generation: OFF by default -----------------------------------------
# Every cloud image provider already requires its own <PREFIX>_API_KEY (unset
# by default, so already inert) — ComfyUI is the one exception: it needs no
# server credential and would otherwise be selectable by anyone with a
# reachable ComfyUI instance. Disabling it here makes the "no image gen"
# stance explicit rather than accidental.
IMAGE_COMFYUI_ENABLED=false
IMAGE_OPENAI_ENABLED=false

# To re-enable for a deployment that wants it: set the matching
# IMAGE_<PROVIDER>_API_KEY in .env.example's "Image Generation" section and
# remove (or set to true) the ENABLED line for that provider. ComfyUI needs no
# key — just flip IMAGE_COMFYUI_ENABLED to true (or delete the line) once you
# have a ComfyUI instance reachable from client browsers.


# --- Video generation: OFF by default -----------------------------------------
# Video is the most bandwidth/cost-intensive generation capability (large
# uploads/downloads per clip, per-second billing on every provider here).
VIDEO_GROK_ENABLED=false
VIDEO_KLING_ENABLED=false
VIDEO_VEO_ENABLED=false
VIDEO_SORA_ENABLED=false
VIDEO_MINIMAX_ENABLED=false
VIDEO_SEEDANCE_ENABLED=false
VIDEO_HAPPYHORSE_ENABLED=false

# To re-enable: set the provider's VIDEO_<PROVIDER>_API_KEY (see .env.example's
# "Video Generation" section) and delete or flip its ENABLED line to true.


# --- TTS: keep the free browser voice, disable paid cloud voices -------------
# TTS_BROWSER_NATIVE runs entirely in the browser (Web Speech API) — no
# network call, no per-use cost, keep it on. Every cloud voice below is a
# metered API call and, for longer narration, real bandwidth.
TTS_OPENAI_ENABLED=false
TTS_AZURE_ENABLED=false
TTS_GLM_ENABLED=false
TTS_QWEN_ENABLED=false
TTS_DOUBAO_ENABLED=false
TTS_MINIMAX_ENABLED=false
TTS_ELEVENLABS_ENABLED=false
# TTS_BROWSER_NATIVE_ENABLED left unset (defaults on) — it's free.

# To re-enable a premium voice: set that provider's TTS_<PROVIDER>_API_KEY
# (see .env.example's "TTS" section) and delete or flip its ENABLED line.
# VoxCPM2 and Lemonade TTS are local/self-hosted alternatives if you want
# better-than-browser voices without per-use cloud cost — see .env.example's
# TTS_VOXCPM_BASE_URL / TTS_LEMONADE_BASE_URL.


# --- Web search: paid APIs off, self-hosted SearXNG is the free option -------
TAVILY_ENABLED=false
EXA_ENABLED=false
WEB_SEARCH_DOUBAO_ENABLED=false
# SearXNG is a self-hosted, free meta-search engine — the bandwidth-conscious
# option if you want web search at all. Requires running your own SearXNG
# instance; see .env.example's "Web Search" section for SEARXNG_BASE_URL.
# SEARXNG_ENABLED=true
# SEARXNG_BASE_URL=

# To re-enable a paid search API: set its API key (see .env.example's
# "Web Search" section) and delete or flip its ENABLED line.
